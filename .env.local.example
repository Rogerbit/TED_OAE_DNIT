# Supabase project settings (Project Settings -> API / Database).
# Copy this file to .env.local and fill in the real values -- .env.local is
# git-ignored and must never be committed.

# Pooled Postgres connection string (Supavisor "Transaction" pooler, port
# 6543) -- used by Drizzle (db/client.ts) for all app queries.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Direct (non-pooled) connection string -- used by drizzle-kit to run
# migrations. If you don't have a separate direct URL, the same value as
# DATABASE_URL (pooler, session mode / port 5432) also works for migrations.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"
